---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const experience = (await getCollection('experience', ({ data }) => !data.draft))
	.sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const certifications = (await getCollection('certifications', ({ data }) => !data.draft))
	.sort((a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0));

const formatMonth = (date: Date) =>
	date.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' });
---

<BaseLayout>
	<!-- 1. HERO -->
	<section id="hero" class="hero-section">
		<div class="container hero-container">
			<h1 class="hero-title">Rubén Ferrer Márquez</h1>
			<p class="hero-tagline">Especialista en Ciberseguridad y Sistemas — Bastionado, análisis forense y respuesta a incidentes</p>
			<div class="hero-links">
				<a href="https://www.linkedin.com/in/rub%C3%A9n-ferrer-8066353ba/" class="btn btn-primary" target="_blank"
					rel="noopener noreferrer">LinkedIn</a>
				<a href="https://github.com/brean-rb" class="btn btn-outline" target="_blank" rel="noopener noreferrer">GitHub</a>
			</div>
		</div>
	</section>

	<!-- 2. SOBRE MÍ -->
	<section id="sobre-mi" class="about-section bg-light">
		<div class="container">
			<h2 class="section-title">Sobre mí</h2>
			<div class="about-content">
				<p>Soy técnico en ciberseguridad y sistemas, con formación en administración de sistemas, redes y análisis de seguridad. Trabajo con Bash, Python y JavaScript, y bastiono servidores Windows y Linux para reducir su superficie de ataque. Me interesa detectar vulnerabilidades, analizar riesgos y comunicarlos con claridad para apoyar la toma de decisiones. Antes de especializarme en ciberseguridad pasé por soporte técnico, administración de redes y desarrollo web, lo que me da una visión práctica de los sistemas que protejo.</p>
			</div>
		</div>
	</section>

	<!-- EXPERIENCIA -->
	<section id="experiencia" class="experience-section bg-light">
		<div class="container">
			<h2 class="section-title">Experiencia</h2>
			<div class="timeline">
				{experience.map((job) => (
					<div class="timeline-item">
						<div class="timeline-content">
							<p class="timeline-role"><strong>{job.data.role}</strong> · {job.data.company}</p>
							<p class="timeline-meta tech-mono">
								{formatMonth(job.data.startDate)} — {job.data.endDate ? formatMonth(job.data.endDate) : 'Actualidad'}
								{job.data.location && ` · ${job.data.location}`}
							</p>
							<p class="timeline-desc">{job.data.description}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 3. SKILLS -->
	<section id="skills" class="skills-section">
		<div class="container">
			<h2 class="section-title">Skills</h2>
			<div class="skills-grid">

				<div class="skill-category">
					<h3>Sistemas y bastionado</h3>
					<div class="tags">
						<span class="tag tech-mono">Windows</span>
						<span class="tag tech-mono">Linux</span>
						<span class="tag tech-mono">Hardening</span>
						<span class="tag tech-mono">ISO 27001</span>
						<span class="tag tech-mono">OpenLDAP</span>
					</div>
				</div>

				<div class="skill-category">
					<h3>Redes y seguridad perimetral</h3>
					<div class="tags">
						<span class="tag tech-mono">pfSense</span>
						<span class="tag tech-mono">Mikrotik</span>
						<span class="tag tech-mono">SSL/TLS</span>
						<span class="tag tech-mono">DMZ</span>
					</div>
				</div>

				<div class="skill-category">
					<h3>Contenedores y DevSecOps</h3>
					<div class="tags">
						<span class="tag tech-mono">Docker</span>
						<span class="tag tech-mono">Kubernetes</span>
					</div>
				</div>

				<div class="skill-category">
					<h3>Análisis forense y respuesta a incidentes</h3>
					<div class="tags">
						<span class="tag tech-mono">Volatility</span>
						<span class="tag tech-mono">Wazuh</span>
						<span class="tag tech-mono">AlienVault SIEM</span>
						<span class="tag tech-mono">Pentesting</span>
					</div>
				</div>

				<div class="skill-category">
					<h3>Desarrollo</h3>
					<div class="tags">
						<span class="tag tech-mono">Bash</span>
						<span class="tag tech-mono">Python</span>
						<span class="tag tech-mono">JavaScript</span>
						<span class="tag tech-mono">Git</span>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- CTF & RETOS -->
	<section id="ctf" class="atenea-section">
		<div class="container">
			<h2 class="section-title">CTF & Retos</h2>
			<div class="atenea-content">
				<div class="atenea-info">
					<p class="atenea-user tech-mono">Br34n</p>
					<p class="atenea-rank">Posición #30 en el ranking global de Atenea (CCN-CERT)</p>
					<a href="https://atenea.ccn-cert.cni.es/scores" class="btn btn-outline" target="_blank" rel="noopener noreferrer">Ver plataforma Atenea</a>
				</div>
				<figure class="atenea-figure">
					<img src="/images/atenea-radar.png" alt="Gráfico radar de progreso en Atenea" />
				</figure>
			</div>
		</div>
	</section>

	<!-- 4. PROYECTOS -->
	<section id="proyectos" class="projects-section bg-light">
		<div class="container">
			<h2 class="section-title">Proyectos</h2>
			<div class="projects-grid">
				{projects.map((project, index) => (
					<article class:list={['card', { 'featured-card': index === 0 }]}>
						<div class="card-content">
							<h3 class="card-title">{project.data.title}</h3>
							<p class="card-stack tech-mono">{project.data.stack.join(' · ')}</p>
							<p class="card-desc">{project.data.draft ? 'Próximamente' : project.data.summary}</p>
						</div>
						<div class="card-footer">
							{project.data.draft ? (
								<span class="btn btn-small btn-primary btn-disabled" aria-disabled="true">Ver más</span>
							) : (
								<a href={`/projects/${project.id}/`} class="btn btn-small btn-primary">Ver más</a>
							)}
						</div>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- CERTIFICADOS Y FORMACIÓN -->
	<section id="certificados" class="certifications-section">
		<div class="container">
			<h2 class="section-title">Certificados y Formación</h2>
			<div class="certifications-grid">
				{certifications.map((cert) => (
					<article class="cert-card">
						<div class="cert-card-header">
							<h3 class="cert-title">{cert.data.title}</h3>
							<span class:list={['cert-badge', { 'cert-badge-completed': cert.data.status === 'completed' }]}>
								{cert.data.status === 'completed' ? 'Completado' : 'En curso'}
							</span>
						</div>
						<p class="cert-issuer">{cert.data.issuer}</p>
						{cert.data.credentialUrl && (
							<a href={cert.data.credentialUrl} class="cert-link" target="_blank" rel="noopener noreferrer">Ver credencial</a>
						)}
					</article>
				))}
			</div>
		</div>
	</section>
</BaseLayout>
